config CANOPEN_NODE_ID
	int "CANopen node ID"
	default 10
	range 1 127
	help
	  7-bit CANopen Node ID

config CANOPEN_LOG_LEVEL
	int "CANopen application log level"
	default 4
	range 0 4
	help
	  Log level used by application modules that handle CANopen data.

config APP_NATIVE_SIM_PH_GAIN_MV_PER_PH
	int "Native-sim pH sensor gain (mV per pH)"
	default 150
	range 1 1000
	help
	  Test-only pH sensor transfer gain. This is independent of CANopen calibration.

config APP_NATIVE_SIM_PH_OFFSET_MV
	int "Native-sim pH sensor offset (mV)"
	default 600
	range 0 3300

config APP_NATIVE_SIM_ORP_GAIN_PER_MV
	int "Native-sim ORP sensor gain in milli-units"
	default 1000
	range 1 10000
	help
	  1000 represents unity voltage gain (1 mV at input produces 1 mV at ADC).

config APP_NATIVE_SIM_ORP_OFFSET_MV
	int "Native-sim ORP sensor offset (mV)"
	default 1650
	range 0 3300

config APP_NATIVE_SIM_IPC_PORT
	int "Native-sim sensor IPC UDP port"
	default 46003
	range 1024 65535

config APP_NATIVE_SIM_COMPANION_IPC_PORT
	int "Native-sim companion IPC UDP port"
	default 46004
	range 1024 65535

config POOL_UPDATE_DIAGNOSTICS
	bool "Record CANopen update timing and reset causes"
	depends on CANOPENNODE_PROGRAM_DOWNLOAD && SOC_FAMILY_STM32
	select HWINFO
	select LOG_RUNTIME_FILTERING
	help
	  Record download progress and callback latency without changing the
	  flash operation. Suppress sensor log noise to preserve diagnostic
	  buffer space. Intended for hardware update regression tests.

# Match the installed Gartennode MCUboot, not Zephyr's offset-swap default.
# Defaults also leave native_sim, which does not use MCUboot, unaffected.
choice MCUBOOT_BOOTLOADER_MODE
	default MCUBOOT_BOOTLOADER_MODE_SWAP_SCRATCH if BOARD_GARTENNODE && BOOTLOADER_MCUBOOT
endchoice

config MCUBOOT_IMGTOOL_SIGN_VERSION
	default "0.1.0" if BOARD_GARTENNODE && BOOTLOADER_MCUBOOT

config MCUBOOT_EXTRA_IMGTOOL_ARGS
	default "--pad" if BOARD_GARTENNODE && BOOTLOADER_MCUBOOT

source "Kconfig.zephyr"
