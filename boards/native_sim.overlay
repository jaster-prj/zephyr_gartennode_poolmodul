/ {
	chosen {
		zephyr,canbus = &can_udp0;
	};

	zephyr,user {
		io-channels = <&adc0 0>, <&adc0 1>;
		io-channel-names = "ph_sensor", "orp_sensor";
	};

	can_udp0: udp-can {
		compatible = "zephyr,native-linux-udp-can";
		host = "127.0.0.1";
		port = <4001>;
		local-port = <4002>;
		status = "okay";
	};

	sensor_sw: sensor_sw {
		compatible = "power-switch";
		gpios = <&gpio0 0 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		status = "okay";
	};

	waterpump_sw: waterpump_sw {
		compatible = "power-switch";
		gpios = <&gpio0 1 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		status = "okay";
	};

	peristaltic1_sw: peristaltic1_sw {
		compatible = "power-switch";
		gpios = <&gpio0 2 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		status = "okay";
	};

	peristaltic2_sw: peristaltic2_sw {
		compatible = "power-switch";
		gpios = <&gpio0 3 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		status = "okay";
	};

	w1_0: w1-zephyr-gpio-0 {
		compatible = "zephyr,w1-gpio";
		gpios = <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		status = "disabled";

		temp_0: ds18b200 {
			compatible = "maxim,ds18b20";
			family-code = <0x28>;
			resolution = <12>;
			status = "disabled";
		};
	};

	aliases {
		green-led = &led0;
	};
};

&adc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	ref-internal-mv = <3300>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
