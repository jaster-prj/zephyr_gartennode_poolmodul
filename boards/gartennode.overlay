/ {
	zephyr,user {
		io-channels = <&adc1 7>, <&adc1 8>;
		io-channel-names = "ph_sensor", "orp_sensor";
	};
	sensor_sw: sensor_sw {
		compatible = "power-switch";
		gpios = <&gpioa 0 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		status = "okay";
	};
	waterpump_sw: waterpump_sw {
		compatible = "power-switch";
		gpios = <&gpioa 1 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		status = "okay";
	};

	peristaltic1_sw: peristaltic1_sw {
		compatible = "power-switch";
		/* using built-in LED pin for demonstration */
		gpios = <&gpiob 0 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		status = "okay";
	};
	peristaltic2_sw: peristaltic2_sw {
		compatible = "power-switch";
		gpios = <&gpiob 1 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		status = "okay";
	};

	w1_0: w1-zephyr-gpio-0 {
		compatible = "zephyr,w1-gpio";
		gpios = <&gpioa 6 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN|GPIO_PULL_UP)>;
		status = "okay";

		temp_0: ds18b200 {
			compatible = "maxim,ds18b20";
			family-code = <0x28>;
			resolution = <12>;
			status = "okay";
		};
	};

	aliases {
		green-led = &green_led;
	};
};

&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;

	/* pinctrl-0 = <&adc1_in5_pa0 &adc1_in6_pa1 &adc1_in7_pa2 &adc1_in8_pa3 &adc1_in9_pa4 &adc1_in10_pa5 &adc1_in11_pa6 &adc1_in12_pa7>; */
	pinctrl-0 = <&adc1_in7_pa2 &adc1_in8_pa3>;
	pinctrl-names = "default";
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};